# Copy to .env (or set as environment variables) to override the defaults in
# src/config.py. Every value below is the current default: leaving a variable
# unset keeps the existing behaviour.

# --- Ollama ---
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.1:8b
EMBED_MODEL=bge-m3

# --- Chroma persistence (default: <project>/chroma_store) ---
# CHROMA_DIR=/app/chroma_store

# --- Chunking / retrieval ---
TOP_K=8
CHUNK_SIZE=800
CHUNK_OVERLAP=100
MIN_PAGE_CHARS=50

# --- Guide tables (JSON list of 1-indexed pages) ---
GUIDE_TABLE_PAGES=[7,13,19]
